{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dev Server (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "preLaunchTask": "vite: dev"
    },
    {
      "name": "Production Build (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4173",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "preLaunchTask": "vite: build-and-preview"
    }
  ]
}
